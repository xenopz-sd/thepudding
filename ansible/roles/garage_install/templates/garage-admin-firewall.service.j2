# MANAGED BY ANSIBLE (garage_install, SVC-03 WS-C53) — DO NOT EDIT BY HAND.
# Re-applies the Garage admin-API firewall after boot and after every Docker
# (re)start: PartOf makes a Docker restart restart this unit too.
[Unit]
Description=Restrict the Garage admin API (port {{ garage_admin_port }}) to allowed sources
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# No ExecStop: a Docker restart stops this unit (PartOf) and must not open the port
# while Docker comes back; removal is an explicit `garage-admin-firewall remove`.
ExecStart=/usr/local/sbin/garage-admin-firewall apply

[Install]
WantedBy=multi-user.target docker.service
