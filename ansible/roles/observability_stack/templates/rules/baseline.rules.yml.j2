{#
  templates/rules/baseline.rules.yml.j2 — observability_stack (SVC-17) — the
  BASELINE Prometheus alerting rules for the whole platform. Rendered onto the
  Prometheus guest at {{ observability_prometheus_rules_dir }}/baseline.rules.yml
  and loaded via the prometheus.yml `rule_files:` glob. Per-service rule
  fragments (e.g. SVC-07's prometheus-openbao-alerts) land in the same dir
  alongside this baseline.

  Spec: .kiro/specs/svc-17-18-observability/ (requirements FR-7, FR-12; design
  §3.2, security-standards "Credential rotation and audit logging"). Task 4.2.

  CONTENTS:
    * baseline platform alerts (FR-7): InstanceDown, DiskSpaceLow (>85% full),
      ContainerOOMKilled / ContainerRestarting (cadvisor), OpenBaoSealed;
    * stack self-alerts (FR-12): PrometheusTargetMissing, GrafanaDown,
      LokiRequestErrors, DiskSpaceLow (applies to the stack guests too);
    * DEFERRED-but-present-and-inert rules, rendered ONLY behind their flag so
      they never reach Prometheus while their dependency is absent:
        - GPU ECC errors (GpuEccErrors) — only `{% if not dcgm_metrics_deferred %}`
          (no GPU host until SVC-23 — requirements FR-4/AC-12);
        - certificate expiry (CertificateExpiringSoon) — only
          `{% if observability_cert_expiry_alert_enabled %}` (off until SVC-08
          issues real certs with an exporter — requirements FR-7 Reconciliation 3).
      Both are documented as deferred; keeping them here (gated) rather than in a
      separate file keeps the baseline the single home for platform alerts while
      guaranteeing the rendered file stays `promtool check rules`-clean (an
      undefined metric in an un-rendered rule can never break evaluation).

  No secret value is rendered here — metric names, thresholds, durations, and
  severities are all non-secret config.
#}
# MANAGED BY ANSIBLE (observability_stack / task 4.2) — DO NOT EDIT BY HAND.
# SVC-17 baseline Prometheus alerting rules. Spec: .kiro/specs/svc-17-18-observability.
# Auto-resolve is inherent to Prometheus alerting (an alert clears when its
# `expr` stops matching). Deferred GPU/cert rules render only behind their flag.
---
groups:
  # --- Baseline platform alerts (FR-7) ---------------------------------------
  - name: platform-baseline
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # InstanceDown — any scrape target unreachable for 5m (FR-7).
      - alert: InstanceDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Scrape target {{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: >-
            {{ '{{' }} $labels.job {{ '}}' }} target
            {{ '{{' }} $labels.instance {{ '}}' }} has been unreachable
            (up == 0) for more than 5 minutes.

      # DiskSpaceLow — node_exporter filesystem >85% full (FR-7). Excludes
      # transient/pseudo filesystems. Applies to every host incl. the stack
      # guests (FR-12 meta-monitoring).
      - alert: DiskSpaceLow
        expr: >-
          100 - ((node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}) * 100)
          > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Disk >85% full on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} is more than 85% full.

      # ContainerOOMKilled — a container was OOM-killed (cadvisor, FR-7).
      - alert: ContainerOOMKilled
        expr: increase(container_oom_events_total[5m]) > 0
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: "Container OOM-killed on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Container {{ '{{' }} $labels.name {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} was OOM-killed in the last
            5 minutes.

      # ContainerRestarting — a container is restart-looping (cadvisor, FR-7).
      - alert: ContainerRestarting
        expr: increase(container_restart_count[15m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container restart-looping on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Container {{ '{{' }} $labels.name {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} has restarted more than
            3 times in 15 minutes.

      # OpenBaoSealed — the primary OpenBao is sealed (FR-7, security baseline).
      # Keyed on the OpenBao-native openbao_core_unsealed metric scraped from the
      # SVC-07 primary; == 0 means sealed. Mirrors the SVC-07 rule fragment so
      # the baseline still carries the security-critical seal alert even before
      # that fragment is present.
      - alert: OpenBaoSealed
        expr: openbao_core_unsealed == 0
        for: 2m
        labels:
          severity: critical
          service: openbao
        annotations:
          summary: "OpenBao is sealed"
          description: >-
            openbao_core_unsealed has been 0 for more than 2 minutes — OpenBao
            is SEALED and cannot serve secrets.

  # --- Stack self-alerts (FR-12 meta-monitoring) -----------------------------
  - name: observability-self
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # PrometheusTargetMissing — a configured target disappeared from discovery.
      - alert: PrometheusTargetMissing
        expr: up == 0
        for: 10m
        labels:
          severity: warning
          service: prometheus
        annotations:
          summary: "Prometheus target missing: {{ '{{' }} $labels.job {{ '}}' }}"
          description: >-
            Target {{ '{{' }} $labels.instance {{ '}}' }} for job
            {{ '{{' }} $labels.job {{ '}}' }} has been absent/down for 10m.

      # GrafanaDown — Grafana self-scrape target down.
      - alert: GrafanaDown
        expr: up{job="observability-stack", service="grafana"} == 0
        for: 5m
        labels:
          severity: critical
          service: grafana
        annotations:
          summary: "Grafana is down"
          description: "The Grafana self-scrape target has been down for 5m."

      # LokiRequestErrors — Loki serving an elevated 5xx request error ratio.
      - alert: LokiRequestErrors
        expr: >-
          100 * sum by (job, route) (rate(loki_request_duration_seconds_count{status_code=~"5.."}[5m]))
          / sum by (job, route) (rate(loki_request_duration_seconds_count[5m]))
          > 10
        for: 15m
        labels:
          severity: warning
          service: loki
        annotations:
          summary: "Loki request error rate high on {{ '{{' }} $labels.route {{ '}}' }}"
          description: >-
            Loki is returning 5xx for more than 10% of requests on route
            {{ '{{' }} $labels.route {{ '}}' }} over the last 15 minutes.
{% if observability_cert_expiry_alert_enabled %}

  # --- DEFERRED: certificate-expiry (rendered only when the flag is ON) -------
  # Inert until SVC-08 issues real certs AND a cert-expiry exporter feeds the
  # `probe_ssl_earliest_cert_expiry` series. Off by default
  # (observability_cert_expiry_alert_enabled=false) — requirements FR-7
  # Reconciliation 3. Present-but-gated so the rendered baseline is never dirty.
  - name: platform-cert-expiry
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      - alert: CertificateExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 14
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expiring soon for {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            The certificate for {{ '{{' }} $labels.instance {{ '}}' }} expires
            in less than 14 days.
{% endif %}
{% if not dcgm_metrics_deferred %}

  # --- DEFERRED: GPU ECC errors (rendered only when NOT deferred) ------------
  # Inert until a GPU host exists (SVC-23) and dcgm-exporter feeds the
  # `DCGM_FI_DEV_ECC_*` series. Deferred by default (dcgm_metrics_deferred=true)
  # — requirements FR-4/AC-12. Present-but-gated so the rendered baseline is
  # never dirty while no GPU host exists.
  - name: platform-gpu
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      - alert: GpuEccErrors
        expr: >-
          increase(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL[10m]) > 0
          or increase(DCGM_FI_DEV_ECC_SBE_VOL_TOTAL[10m]) > 0
        for: 5m
        labels:
          severity: critical
          service: gpu
        annotations:
          summary: "GPU ECC errors on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            dcgm-exporter reports ECC memory errors on GPU
            {{ '{{' }} $labels.gpu {{ '}}' }} of
            {{ '{{' }} $labels.instance {{ '}}' }}.
{% endif %}
