{#
  templates/rules/baseline.rules.yml.j2 — observability_stack (SVC-17) — the
  BASELINE Prometheus alerting rules for the whole platform. Rendered onto the
  Prometheus guest at {{ observability_prometheus_rules_dir }}/baseline.rules.yml
  and loaded via the prometheus.yml `rule_files:` glob. Per-service rule
  fragments (e.g. SVC-07's prometheus-openbao-alerts) land in the same dir
  alongside this baseline.

  Spec: .kiro/specs/svc-17-18-observability/ (requirements FR-7, FR-12; design
  §3.2, security-standards "Credential rotation and audit logging"). Task 4.2.

  CONTENTS:
    * baseline platform alerts (FR-7): InstanceDown, DiskSpaceLow (>85% full),
      ContainerOOMKilled / ContainerRestarting (cadvisor), OpenBaoSealed;
    * stack self-alerts (FR-12): PrometheusTargetMissing, GrafanaDown,
      LokiRequestErrors, DiskSpaceLow (applies to the stack guests too);
    * DEFERRED-but-present-and-inert rules, rendered ONLY behind their flag so
      they never reach Prometheus while their dependency is absent:
        - GPU ECC errors (GpuEccErrors) — only `{% if not dcgm_metrics_deferred %}`
          (no GPU host until SVC-23 — requirements FR-4/AC-12);
        - certificate expiry (CertificateExpiringSoon) — only
          `{% if observability_cert_expiry_alert_enabled %}` (off until SVC-08
          issues real certs with an exporter — requirements FR-7 Reconciliation 3).
      Both are documented as deferred; keeping them here (gated) rather than in a
      separate file keeps the baseline the single home for platform alerts while
      guaranteeing the rendered file stays `promtool check rules`-clean (an
      undefined metric in an un-rendered rule can never break evaluation).

  No secret value is rendered here — metric names, thresholds, durations, and
  severities are all non-secret config.
#}
# MANAGED BY ANSIBLE (observability_stack / task 4.2) — DO NOT EDIT BY HAND.
# SVC-17 baseline Prometheus alerting rules. Spec: .kiro/specs/svc-17-18-observability.
# Auto-resolve is inherent to Prometheus alerting (an alert clears when its
# `expr` stops matching). Deferred GPU/cert rules render only behind their flag.
---
groups:
  # --- Baseline platform alerts (FR-7) ---------------------------------------
  - name: platform-baseline
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # InstanceDown — any scrape target unreachable for 5m (FR-7).
      - alert: InstanceDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Scrape target {{ '{{' }} $labels.instance {{ '}}' }} is down"
          description: >-
            {{ '{{' }} $labels.job {{ '}}' }} target
            {{ '{{' }} $labels.instance {{ '}}' }} has been unreachable
            (up == 0) for more than 5 minutes.

      # DiskSpaceLow — node_exporter filesystem >85% full (FR-7). Excludes
      # transient/pseudo filesystems. Applies to every host incl. the stack
      # guests (FR-12 meta-monitoring).
      - alert: DiskSpaceLow
        expr: >-
          100 - ((node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}) * 100)
          > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Disk >85% full on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} is more than 85% full.

      # ContainerOOMKilled — a container was OOM-killed (cadvisor, FR-7).
      - alert: ContainerOOMKilled
        expr: increase(container_oom_events_total[5m]) > 0
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: "Container OOM-killed on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Container {{ '{{' }} $labels.name {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} was OOM-killed in the last
            5 minutes.

      # ContainerRestarting — a container is restart-looping (cadvisor, FR-7).
      - alert: ContainerRestarting
        expr: increase(container_restart_count[15m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container restart-looping on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            Container {{ '{{' }} $labels.name {{ '}}' }} on
            {{ '{{' }} $labels.instance {{ '}}' }} has restarted more than
            3 times in 15 minutes.

      # OpenBaoSealed — the primary OpenBao is sealed (FR-7, security baseline).
      # Keyed on the OpenBao-native openbao_core_unsealed metric scraped from the
      # SVC-07 primary; == 0 means sealed. Mirrors the SVC-07 rule fragment so
      # the baseline still carries the security-critical seal alert even before
      # that fragment is present.
      - alert: OpenBaoSealed
        expr: max by (instance) (openbao_core_unsealed) == 0
        for: 2m
        labels:
          severity: critical
          service: openbao
        annotations:
          summary: "OpenBao is sealed"
          description: >-
            openbao_core_unsealed has been 0 for more than 2 minutes — OpenBao
            is SEALED and cannot serve secrets.

  # --- SVC-03 Garage object storage (spec svc-03-alerts, WS-C52) --------------
  # Garage's own /metrics (scraped as service="garage") carries cluster health
  # and per-node disk figures, so no node_exporter is needed on the Garage guests.
  # Every node reports the same cluster view; min()/max() across nodes make one
  # alert per condition, not one per node. A down node's own target is covered by
  # the generic InstanceDown rule.
  - name: platform-garage
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # A storage node in the layout is not connected (reads/writes continue with
      # 2 of 3, replication is degraded).
      - alert: GarageStorageNodeDown
        expr: >-
          min(cluster_storage_nodes_ok{service="garage"})
          < max(cluster_storage_nodes{service="garage"})
        for: 5m
        labels:
          severity: warning
          service: garage
        annotations:
          summary: "Garage storage node(s) not connected"
          description: >-
            Only {{ '{{' }} $value {{ '}}' }} of the Garage storage nodes are
            connected. Reads and writes continue while a quorum remains; check the
            node container and RPC port 3901.
      # Some partitions have no write quorum: some writes fail now.
      - alert: GarageQuorumLost
        expr: >-
          min(cluster_partitions_quorum{service="garage"})
          < max(cluster_partitions{service="garage"})
        for: 2m
        labels:
          severity: critical
          service: garage
        annotations:
          summary: "Garage partitions without write quorum"
          description: >-
            {{ '{{' }} $value {{ '}}' }} Garage partitions have a write quorum
            (fewer than all): writes to some objects fail. At least two storage
            nodes are unreachable.
      # Data has fewer live copies than the replication factor for a long time.
      - alert: GarageUnderReplicated
        expr: >-
          min(cluster_partitions_all_ok{service="garage"})
          < max(cluster_partitions{service="garage"})
        for: 30m
        labels:
          severity: warning
          service: garage
        annotations:
          summary: "Garage data under-replicated for 30 minutes"
          description: >-
            Only {{ '{{' }} $value {{ '}}' }} Garage partitions have all their
            copies reachable. Restore the missing node; if it is gone for good,
            replace it in the layout.
      # A node's data volume is more than 80 % full (requirements §13).
      - alert: GarageDiskAlmostFull
        expr: >-
          1 - (garage_local_disk_avail{service="garage", volume="data"}
               / garage_local_disk_total{service="garage", volume="data"}) > 0.8
        for: 15m
        labels:
          severity: warning
          service: garage
        annotations:
          summary: "Garage data volume over 80 % on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            The Garage data volume on {{ '{{' }} $labels.instance {{ '}}' }} is more
            than 80 % full. Grow garage_data_disk_gb and update the node capacity,
            or add a node.
      # Blocks keep failing to resync (corruption or a persistent peer failure).
      - alert: GarageResyncErrors
        expr: max by (instance) (block_resync_errored_blocks{service="garage"}) > 0
        for: 30m
        labels:
          severity: warning
          service: garage
        annotations:
          summary: "Garage block resync errors on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            {{ '{{' }} $value {{ '}}' }} blocks on {{ '{{' }} $labels.instance {{ '}}' }}
            failed their last resync for 30 minutes.
      # Server-side S3 errors (5xx) above 5 % of requests. Client errors (403/404)
      # are normal traffic and are not counted.
      - alert: GarageS3ServerErrors
        expr: >-
          sum(rate(api_s3_error_counter{service="garage", status_code=~"5.."}[5m]))
          / sum(rate(api_s3_request_counter{service="garage"}[5m])) > 0.05
        for: 15m
        labels:
          severity: warning
          service: garage
        annotations:
          summary: "Garage S3 API returning server errors"
          description: >-
            More than 5 % of Garage S3 requests returned a 5xx status over 15
            minutes.

  # --- SVC-10 internal DNS (spec svc-10-internal-dns, §13) --------------------
  - name: platform-dns
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # The recursor is what developer machines (and later the CA) query; when it
      # is down platform names stop resolving for them (guests keep their own
      # upstream resolver, FR-4).
      - alert: DnsRecursorDown
        expr: up{service="pdns-recursor"} == 0
        for: 2m
        labels:
          severity: critical
          service: dns
        annotations:
          summary: "SVC-10 DNS recursor is down"
          description: >-
            The PowerDNS recursor metrics target {{ '{{' }} $labels.instance {{ '}}' }}
            has been down for 2 minutes: platform names do not resolve for clients
            that use the platform resolver. Re-run svc-10-bootstrap.yml.
      # More than 10 % SERVFAIL answers (upstream unreachable, or the authoritative
      # server not answering the platform zone).
      - alert: DnsRecursorServfailRate
        expr: >-
          sum(rate(pdns_recursor_servfail_answers{service="pdns-recursor"}[5m]))
          / sum(rate(pdns_recursor_questions{service="pdns-recursor"}[5m])) > 0.1
        for: 10m
        labels:
          severity: warning
          service: dns
        annotations:
          summary: "SVC-10 DNS recursor SERVFAIL rate above 10 %"
          description: >-
            More than 10 % of the recursor's answers were SERVFAIL over 10 minutes.
            Check the authoritative container (pdns-auth-1) and the guest's upstream
            connectivity.
  # --- Stack self-alerts (FR-12 meta-monitoring) -----------------------------
  - name: observability-self
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      # PrometheusTargetMissing — a configured target disappeared from discovery.
      - alert: PrometheusTargetMissing
        expr: up == 0
        for: 10m
        labels:
          severity: warning
          service: prometheus
        annotations:
          summary: "Prometheus target missing: {{ '{{' }} $labels.job {{ '}}' }}"
          description: >-
            Target {{ '{{' }} $labels.instance {{ '}}' }} for job
            {{ '{{' }} $labels.job {{ '}}' }} has been absent/down for 10m.

      # GrafanaDown — Grafana self-scrape target down.
      - alert: GrafanaDown
        expr: up{job="observability-stack", service="grafana"} == 0
        for: 5m
        labels:
          severity: critical
          service: grafana
        annotations:
          summary: "Grafana is down"
          description: "The Grafana self-scrape target has been down for 5m."

      # LokiRequestErrors — Loki serving an elevated 5xx request error ratio.
      - alert: LokiRequestErrors
        expr: >-
          100 * sum by (job, route) (rate(loki_request_duration_seconds_count{status_code=~"5.."}[5m]))
          / sum by (job, route) (rate(loki_request_duration_seconds_count[5m]))
          > 10
        for: 15m
        labels:
          severity: warning
          service: loki
        annotations:
          summary: "Loki request error rate high on {{ '{{' }} $labels.route {{ '}}' }}"
          description: >-
            Loki is returning 5xx for more than 10% of requests on route
            {{ '{{' }} $labels.route {{ '}}' }} over the last 15 minutes.
  # --- SVC-08: certificates served by Traefik (ACME from the platform CA, or any other resolver) ---
  # Bound to Traefik's own `traefik_tls_certs_not_after` series (live-confirmed, scraped on :8082), so no extra
  # exporter is needed. Traefik renews ACME certificates 30 days before expiry; firing at 14 days means renewal
  # has failed (CA down, DNS-01 broken). Spec svc-08-internal-pki D7 (revised).
  - name: platform-pki
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      - alert: PlatformCertExpiringSoon
        expr: (min by (cn, instance) (traefik_tls_certs_not_after{service="traefik"}) - time()) / 86400 < 14
        for: 1h
        labels:
          severity: warning
          service: pki
        annotations:
          summary: "Traefik certificate {{ '{{' }} $labels.cn {{ '}}' }} expires in under 14 days"
          description: >-
            Traefik serves a certificate for {{ '{{' }} $labels.cn {{ '}}' }} that expires in
            {{ '{{' }} $value | humanize {{ '}}' }} days. Renewal should have happened at 30 days: check the
            Traefik logs for ACME errors, OpenBao (SVC-07) and the PowerDNS API (SVC-10).
      - alert: PlatformCertExpired
        expr: min by (cn, instance) (traefik_tls_certs_not_after{service="traefik"}) - time() < 0
        for: 5m
        labels:
          severity: critical
          service: pki
        annotations:
          summary: "Traefik serves an expired certificate for {{ '{{' }} $labels.cn {{ '}}' }}"
          description: >-
            Clients that verify TLS now fail for every route covered by {{ '{{' }} $labels.cn {{ '}}' }}.
{% if observability_cert_expiry_alert_enabled %}

  # --- DEFERRED: certificate-expiry (rendered only when the flag is ON) -------
  # Inert until SVC-08 issues real certs AND a cert-expiry exporter feeds the
  # `probe_ssl_earliest_cert_expiry` series. Off by default
  # (observability_cert_expiry_alert_enabled=false) — requirements FR-7
  # Reconciliation 3. Present-but-gated so the rendered baseline is never dirty.
  - name: platform-cert-expiry
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      - alert: CertificateExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 14
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expiring soon for {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            The certificate for {{ '{{' }} $labels.instance {{ '}}' }} expires
            in less than 14 days.
{% endif %}
{% if not dcgm_metrics_deferred %}

  # --- DEFERRED: GPU ECC errors (rendered only when NOT deferred) ------------
  # Inert until a GPU host exists (SVC-23) and dcgm-exporter feeds the
  # `DCGM_FI_DEV_ECC_*` series. Deferred by default (dcgm_metrics_deferred=true)
  # — requirements FR-4/AC-12. Present-but-gated so the rendered baseline is
  # never dirty while no GPU host exists.
  - name: platform-gpu
    interval: "{{ observability_prometheus_evaluation_interval }}"
    rules:
      - alert: GpuEccErrors
        expr: >-
          increase(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL[10m]) > 0
          or increase(DCGM_FI_DEV_ECC_SBE_VOL_TOTAL[10m]) > 0
        for: 5m
        labels:
          severity: critical
          service: gpu
        annotations:
          summary: "GPU ECC errors on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: >-
            dcgm-exporter reports ECC memory errors on GPU
            {{ '{{' }} $labels.gpu {{ '}}' }} of
            {{ '{{' }} $labels.instance {{ '}}' }}.
{% endif %}
