#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
# 0600 runtime SECRET env for the Grafana container, layered onto the Compose
# stack via docker-compose-app `extra_env_files`. Carries the ONLY secret-bearing
# Grafana env values; the non-secret docker-compose-app .env carries config only
# (integration-boundaries §2, security-standards). Written by tasks/grafana.yml
# at 0600; NEVER committed, NEVER echoed (the writing task is no_log).
#
# GF_SECURITY_ADMIN_PASSWORD: the Break_Glass_Admin local account password,
#   sourced from OpenBao ({{ observability_grafana_admin_secret_path }}), rotated
#   after use. Grafana's GF_SECURITY_ADMIN_USER is set from the non-secret .env.
GF_SECURITY_ADMIN_USER={{ observability_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ observability_grafana_admin_password }}
{% if grafana_oidc_enabled | bool %}
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: the ZITADEL OIDC client secret (Mock A
#   flipped to real), sourced from OpenBao
#   ({{ observability_grafana_oidc_secret_path }}). Overrides the grafana.ini
#   generic_oauth block's (absent) secret at runtime.
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ observability_grafana_oidc_client_secret }}
{% endif %}
