{#
  templates/targets/service-target.yaml.j2 — observability_stack (SVC-17/18)
  A single Built_Service's Prometheus `file_sd_configs` target file. Rendered by
  tasks/scrape_targets.yml onto the Prometheus guest at
  {{ observability_prometheus_targets_dir }}/{{ observability_scrape_targets_file_prefix }}<service>.yaml
  and discovered by the shipped prometheus.yml.j2 `platform-services` job
  (file_sd glob service-*.yaml).

  Spec: .kiro/specs/svc-17-18-observability/ (requirements FR-8/FR-11/FR-12,
  design §3.4). Task 5.1.

  INPUT (one dict, passed as `target_spec` by the include_template loop):
    service          : the `service` label + file suffix.
    port             : metrics port on the guest VLAN-20 IP.
    metrics_path     : OPTIONAL non-default path  -> __metrics_path__ label.
    scheme           : OPTIONAL non-default scheme -> __scheme__ label.
    params           : OPTIONAL {name: value}      -> __param_<name> label(s).
    scrape_interval  : OPTIONAL (documentation only here; per-target scrape
                       interval is a job concern, kept as a plain label for
                       operator visibility, never a reserved label).
    hosts            : list of {ip, project} — one entry per discovered guest in
                       this service's inventory group (already degrade-filtered
                       by the task: this template is only rendered when hosts is
                       non-empty).

  file_sd format: a YAML list of target groups, each `{targets: [...], labels}`.
  Per-target path/scheme/param differences are carried as Prometheus's RESERVED
  discovery labels (__metrics_path__ / __scheme__ / __param_<name>), which
  Prometheus consumes directly during relabeling — so the single shipped
  `platform-services` job scrapes each target on its correct path/scheme with NO
  per-service job edit. The `project`/`service` labels are ordinary target
  labels (FR-11). NO secret value is rendered here — endpoints + labels only.
#}
# GENERATED BY ANSIBLE (observability_stack / task 5.1) — DO NOT EDIT BY HAND.
# Prometheus file_sd target file for Built_Service '{{ target_spec.service }}'.
# Regenerated from the dynamic inventory on every run (FR-8); a service absent
# from the inventory yields no file at all (degrade — design §3.4).
# Spec: .kiro/specs/svc-17-18-observability.
---
{% for host in target_spec.hosts %}
- targets:
    - "{{ host.ip }}:{{ target_spec.port }}"
  labels:
    project: "{{ host.project }}"
    service: "{{ target_spec.service }}"
{% if target_spec.scheme is defined and target_spec.scheme %}
    __scheme__: "{{ target_spec.scheme }}"
{% endif %}
{% if target_spec.metrics_path is defined and target_spec.metrics_path %}
    __metrics_path__: "{{ target_spec.metrics_path }}"
{% endif %}
{% if target_spec.params is defined and target_spec.params %}
{% for pname, pvalue in target_spec.params.items() %}
    __param_{{ pname }}: "{{ pvalue }}"
{% endfor %}
{% endif %}
{% endfor %}
