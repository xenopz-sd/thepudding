# MANAGED BY ANSIBLE (openbao_install / task 11.1) — DO NOT EDIT BY HAND.
[Unit]
Description=Nightly 02:00 UTC trigger for the OpenBao Raft snapshot (SVC-07 / Req 11.1)

[Timer]
# 02:00 UTC every day (Req 11.1). UTC suffix pins the zone regardless of host localtime.
OnCalendar={{ openbao_backup_oncalendar }}
# Fire a missed run on next boot rather than skipping a night's backup.
Persistent={{ openbao_backup_persistent | lower }}
Unit={{ openbao_backup_service_name }}.service

[Install]
WantedBy=timers.target
