{#
  templates/compose.yaml.j2 — docker-compose-app (generic)

  Renders a compose.yaml from the service-supplied `dca_services` /
  `dca_volumes` / `dca_networks` variable set. Owns no service-specific
  knowledge. NO secret value is ever rendered here: `env_file` points at the
  sibling `.env` (non-secret config only), and runtime secrets are fetched from
  OpenBao by the Agent at container start (integration-boundaries §2).

  Notes:
    - `ports:` is NOT emitted by default. Web-facing services register with
      Traefik via labels (PF FR-7 / integration-boundaries §1); a host port for
      LAN/public ingress would violate that boundary. A service MAY set an
      explicit `ports:` list ONLY for the documented exception of a PRIVATE,
      VLAN-bound port that is NOT LAN/Traefik ingress — bind it to the guest's
      VLAN IP (e.g. "10.0.20.11:8200:8200"), never 0.0.0.0. The sole current use
      is the SVC-07 Transit UNSEALER, whose seal API must be reachable by the
      primary OpenBao over VLAN 20 (a different LXC) — see openbao_install's
      unsealer stack. This does not open a Traefik/LAN ingress path (no 0.0.0.0
      bind, no host-wide exposure), so it does not violate FR-7; it is the
      private cross-LXC seal path FR-7 never governed.
    - `runtime_options` (e.g. --memory-swappiness=0) are container-create flags
      that Compose does not model as first-class keys; they are carried under
      the service's `x-runtime-options` extension field for documentation and,
      where supported, mapped onto `mem_swappiness`.
#}
# MANAGED BY ANSIBLE (docker-compose-app) — DO NOT EDIT BY HAND.
# Stack: {{ dca_app_name }}
---
name: {{ dca_app_name }}

services:
{% for svc in dca_services %}
  {{ svc.name }}:
    image: "{{ svc.image }}"
{% if svc.command is defined %}
    command: {{ svc.command | to_json }}
{% endif %}
    restart: "{{ svc.restart | default('unless-stopped') }}"
{% if svc.ports is defined and svc.ports | length > 0 %}
    # Opt-in ONLY: a private VLAN-bound port (NOT Traefik/LAN ingress). Bind to
    # the guest VLAN IP, never 0.0.0.0. See the header note + PF FR-7 exception.
    ports:
{% for port in svc.ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}
{% if svc.user is defined %}
    user: "{{ svc.user }}"
{% endif %}
{% if svc.environment is defined and svc.environment | length > 0 %}
{#   Opt-in: a per-service `environment:` map of NON-secret runtime env vars,
     rendered inline on the container. NO secret VALUE belongs here — runtime
     secrets arrive via OpenBao/the Agent or a 0600 extra_env_files file
     (integration-boundaries §2), never this committed template. The sole
     current use is the openbao-agent SIDECAR setting BAO_SKIP_DROP_ROOT=1: the
     openbao image entrypoint su-exec's `bao` subcommands to the non-root
     `openbao` user unless this is set, and a dropped-root sidecar cannot read
     its own root-owned 0640 agent.hcl nor the 0600 root:root role-id/secret-id
     mounts — so it must stay root to match the primary's root posture WITHOUT
     loosening those deliberately-0600 host secret files (security-standards /
     integration-boundaries §2). Absent ⇒ renders exactly as before. #}
    environment:
{% for env_key, env_val in svc.environment | dictsort %}
      {{ env_key }}: "{{ env_val }}"
{% endfor %}
{% endif %}
{% if svc.cap_add is defined and svc.cap_add | length > 0 %}
    cap_add:
{% for cap in svc.cap_add %}
      - {{ cap }}
{% endfor %}
{% endif %}
{% if svc.mem_swappiness is defined %}
    mem_swappiness: {{ svc.mem_swappiness }}
{% endif %}
{% if svc.healthcheck is defined %}
{#   Opt-in: a container healthcheck. Used by the openbao-workload-auth swap-gate
     so a dependent service can wait on `condition: service_healthy`. `test` is a
     list (CMD form); interval/timeout/retries/start_period are optional. #}
    healthcheck:
      test: {{ svc.healthcheck.test | to_json }}
{% if svc.healthcheck.interval is defined %}
      interval: "{{ svc.healthcheck.interval }}"
{% endif %}
{% if svc.healthcheck.timeout is defined %}
      timeout: "{{ svc.healthcheck.timeout }}"
{% endif %}
{% if svc.healthcheck.retries is defined %}
      retries: {{ svc.healthcheck.retries }}
{% endif %}
{% if svc.healthcheck.start_period is defined %}
      start_period: "{{ svc.healthcheck.start_period }}"
{% endif %}
{% endif %}
{% if svc.depends_on is defined and svc.depends_on | length > 0 %}
{#   Opt-in: a long-form `depends_on` mapping of `<service>: { condition: ... }`.
     The openbao-workload-auth swap-gate uses `condition: service_healthy` so the
     workload starts ONLY after the Agent sidecar has rendered the secret file —
     a sealed/unreachable Primary leaves the Agent unhealthy and the workload
     never starts (fail-closed, composition-wiring.md). #}
    depends_on:
{% for dep_name, dep_cfg in svc.depends_on | dictsort %}
      {{ dep_name }}:
        condition: "{{ dep_cfg.condition }}"
{% endfor %}
{% endif %}
{% if svc.env_file | default(true) %}
    env_file:
      - .env
{% if svc.extra_env_files is defined and svc.extra_env_files | length > 0 %}
{#   Opt-in ONLY: additional env_file paths APPENDED after the non-secret .env.
     A later env_file wins on key conflicts (Compose merge order), so a service
     MAY layer a 0600 secret-bearing runtime env (written to the guest, NEVER the
     repo) on top of the non-secret .env — e.g. SVC-01 Postgres' POSTGRES_PASSWORD
     in /etc/postgresql/postgres.secret.env. No secret VALUE is rendered here; only
     the PATH is emitted (integration-boundaries §2 — the value lives in the 0600
     file / OpenBao, not in this committed template).

     Each entry is EITHER a plain string (the path; implicitly required — Compose
     aborts at `up` if the file is absent) OR a mapping {path: <p>, required:
     <bool>}. The mapping long-form exists for RUNTIME-RENDERED files that do not
     exist at `up`-validation time — e.g. the openbao-agent Rendered_Secret_File,
     written by the Agent sidecar only after it auto-auths. Compose eagerly
     validates every REQUIRED env_file path before honoring depends_on, so a hard
     reference to a not-yet-rendered file aborts the stack before the swap-gate
     (depends_on: service_healthy) can run. `required: false` (long-form, Compose
     v2.24+) suppresses ONLY that up-front existence check; the workload still
     starts only once the Agent's healthcheck passes. Plain strings render
     byte-identically to before — existing string callers are unaffected. #}
{% for extra in svc.extra_env_files %}
{% if extra is mapping %}
      - path: "{{ extra.path }}"
        required: {{ (extra.required | default(true)) | string | lower }}
{% else %}
      - "{{ extra }}"
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% if svc.volumes is defined and svc.volumes | length > 0 %}
    volumes:
{% for vol in svc.volumes %}
      - "{{ vol }}"
{% endfor %}
{% endif %}
{% if svc.networks is defined and svc.networks | length > 0 %}
    networks:
{% for net in svc.networks %}
      - {{ net }}
{% endfor %}
{% endif %}
{% if svc.labels is defined and svc.labels | length > 0 %}
    labels:
{% for label in svc.labels %}
      - "{{ label }}"
{% endfor %}
{% endif %}
{% if svc.runtime_options is defined and svc.runtime_options | length > 0 %}
    # runtime container-create flags (not first-class Compose keys):
    x-runtime-options:
{% for opt in svc.runtime_options %}
      - "{{ opt }}"
{% endfor %}
{% endif %}
{% endfor %}

{% if dca_volumes | length > 0 %}
volumes:
{% for vol in dca_volumes %}
  {{ vol }}:
{% endfor %}
{% endif %}

{% if dca_networks | length > 0 %}
networks:
{% for net in dca_networks %}
  {{ net.name }}:
{% if net.external | default(false) %}
    external: true
{% endif %}
{% endfor %}
{% endif %}
