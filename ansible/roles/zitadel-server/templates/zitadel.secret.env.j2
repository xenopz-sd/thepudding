# {{ ansible_managed }}
# 0600 runtime SECRET env for the ZITADEL container, layered onto the Compose
# stack via docker-compose-app `extra_env_files`. This file carries the ONLY
# secret-bearing ZITADEL env values; the non-secret docker-compose-app .env
# carries config only (integration-boundaries §2, security-standards). Written
# by the zitadel-server role at 0600; NEVER committed, NEVER echoed (the writing
# task is no_log).
#
# ZITADEL_MASTERKEY: the master encryption key — EXACTLY 32 bytes (a 32-char ASCII
# key used verbatim, NOT base64-encoded; ZITADEL rejects a non-32-byte key).
# Generated once at first init and NEVER rotated without a full data re-encryption
# migration (requirements §6). Sourced from OpenBao (secret/proj-shared-zitadel/zitadel).
ZITADEL_MASTERKEY={{ zitadel_masterkey }}
# Backing-DB passwords (the SVC-01 app role). ZITADEL splits an "admin" DB
# identity (first-init migrations) from the runtime "user" identity; on this
# platform both are the least-privilege SVC-01 app role, so the same password.
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD={{ zitadel_db_password }}
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD={{ zitadel_db_password }}
