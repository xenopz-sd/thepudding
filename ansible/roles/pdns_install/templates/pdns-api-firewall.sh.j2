#!/bin/sh
# MANAGED BY ANSIBLE (pdns_install, SVC-10) — DO NOT EDIT BY HAND.
# Lets only the allowed sources open connections to the PowerDNS webservers (the
# authoritative HTTP API + metrics on {{ pdns_auth_web_port }}, the recursor metrics on
# {{ pdns_recursor_web_port }}). Docker DNATs the published ports, so the traffic is only
# visible in FORWARD -> DOCKER-USER; match the ORIGINAL destination port and
# direction so reply packets and the DNS ports are untouched (WS-C53 pattern).
#   pdns-api-firewall apply   (idempotent)
#   pdns-api-firewall remove
set -eu
CHAIN=PDNS-API
PORTS="{{ pdns_auth_web_port }} {{ pdns_recursor_web_port }}"

jump() {
  echo "-p tcp -m conntrack --ctorigdstport $1 --ctdir ORIGINAL -j $CHAIN"
}

remove() {
  for port in $PORTS; do
    # shellcheck disable=SC2046
    while iptables -C DOCKER-USER $(jump "$port") 2>/dev/null; do iptables -D DOCKER-USER $(jump "$port"); done
  done
  if iptables -nL "$CHAIN" >/dev/null 2>&1; then
    iptables -F "$CHAIN"
    iptables -X "$CHAIN"
  fi
}

apply() {
  iptables -nL DOCKER-USER >/dev/null 2>&1 || { echo "DOCKER-USER chain missing (is Docker running?)" >&2; exit 1; }
  iptables -nL "$CHAIN" >/dev/null 2>&1 || iptables -N "$CHAIN"
  iptables -F "$CHAIN"
{% for src in (pdns_api_allowed_sources + ([pdns_admin_source_cidr] if (pdns_admin_source_cidr | trim | length) > 0 else [])) %}
  iptables -A "$CHAIN" -s {{ src | trim }} -j RETURN
{% endfor %}
  iptables -A "$CHAIN" -j DROP
  for port in $PORTS; do
    # shellcheck disable=SC2046
    iptables -C DOCKER-USER $(jump "$port") 2>/dev/null || iptables -I DOCKER-USER 1 $(jump "$port")
  done
}

case "${1:-apply}" in
  apply) apply ;;
  remove) remove ;;
  *) echo "usage: $0 apply|remove" >&2; exit 2 ;;
esac
