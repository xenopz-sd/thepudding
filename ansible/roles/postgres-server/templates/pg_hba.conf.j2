{#
  templates/pg_hba.conf.j2 — postgres-server (SVC-01)
  Restrict connections to localhost + the project's own subnet; require TLS for
  any non-localhost connection (SVC-01 §12). No secret here.
#}
# MANAGED BY ANSIBLE (postgres-server) — DO NOT EDIT BY HAND.
# SVC-01 pg_hba for project {{ postgres_project_slug }} (VLAN {{ postgres_vlan_id }}).
# TYPE  DATABASE  USER  ADDRESS                              METHOD
# Local UNIX-socket connections use `trust`: the socket lives inside the
# container and is reachable only by in-container processes (filesystem-guarded),
# and the installer's idempotent DDL (CREATE DATABASE / CREATE ROLE) runs as the
# superuser over THIS socket with NO password on the argv (passwords stay in the
# 0600 secret env / OpenBao). A `scram-sha-256` here breaks that bootstrap DDL
# with `fe_sendauth: no password supplied` (live-caught in SVC-01 Task 12
# acceptance). Loopback TCP + the project subnet still require scram/TLS below.
local   all       all                                        trust
host    all       all   127.0.0.1/32                         scram-sha-256
host    all       all   ::1/128                              scram-sha-256
# Project subnet only — never the LAN/other VLANs. The connection-type is
# derived from the single source of truth `postgres_ssl_enabled`
# (fix-pg-hba-hostssl-vs-ssl-off) so it is ALWAYS satisfiable under the server's
# current `ssl` state: `hostssl` (TLS-required) when ssl = on, `host` (plaintext
# or TLS, on the private VLAN subnet) when ssl = off. A `hostssl` rule emitted
# while the server runs `ssl = off` is unsatisfiable and locks the app role out
# of TCP entirely — that contradiction is what this derivation prevents.
{% set _pg_conn = 'hostssl' if postgres_ssl_enabled | bool else 'host' %}
{{ _pg_conn }} {{ postgres_db_name }}  {{ postgres_app_role }}  10.0.{{ postgres_vlan_id }}.0/24  scram-sha-256
{{ _pg_conn }} {{ postgres_db_name }}  {{ postgres_exporter_role }}  10.0.{{ postgres_vlan_id }}.0/24  scram-sha-256
{% if postgres_client_nontls_subnet | default(false) | bool %}
# OPT-IN (postgres_client_nontls_subnet, default OFF): a non-TLS subnet entry for
# the app role covering ALL databases — including the `postgres` maintenance DB a
# cross-guest client (e.g. ZITADEL start-from-init) must reach to verify/create
# its own database. Enabled ONLY for a dedicated backing instance on the trusted
# VLAN-{{ postgres_vlan_id }} subnet while no SVC-08/EJBCA cert exists yet; it is
# turned back off (and the client switched to sslmode=verify-full) once a real CA
# issues the DB a certificate. Still scram-sha-256 (password), still subnet-scoped.
host    all  {{ postgres_app_role }}  10.0.{{ postgres_vlan_id }}.0/24  scram-sha-256
{% endif %}
