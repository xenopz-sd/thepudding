# .env.example — template for LIVE / requires-infra acceptance tests
#
# Copy this to `.env` (which is gitignored) and fill in real values for your
# EPHEMERAL Proxmox SDN test cluster. NEVER commit `.env`, and never put real
# tokens in this `.env.example` — the values below are placeholders only.
#
#   cp .env.example .env
#   $EDITOR .env            # fill in real endpoint + token values
#
# These variables gate the `requires-infra` tests under `infra/tests/`. When
# they are absent the tests skip cleanly (documentation-testing steering:
# "absent infra => skipped, not failed"); when present the tests run real
# `terraform apply`/`destroy` against the cluster. See the README section
# "Live / acceptance tests (requires infra)" for the run procedure.
#
# SECURITY (security-standards.md):
#   * No secret is ever committed to the repo — `.env` is gitignored; keep it so.
#   * A Proxmox API token has the format:  <user>@<realm>!<token-id>=<uuid>
#   * Tokens are rotated on suspected compromise; these are TEST-cluster creds,
#     never production, and never a token with the built-in Administrator role.

# --- Group 1: live SDN apply + destroy-isolation (3 tests) ------------------
# Used by:
#   infra/tests/test_integration_apply.py
#     ::TestFullEphemeralApplyCoexistence::test_foundation_then_two_projects_coexist_with_distinct_vlans
#   infra/tests/test_destroy_isolation.py
#     ::TestLiveDestroyIsolation::test_destroy_project_a_leaves_foundation_and_project_b_intact
#   infra/tests/test_degraded_modes.py
#     ::TestApplierFailureIsTracked (needs a live cluster)
#
# This token MUST carry the SDN.Allocate privilege (it performs real SDN
# apply/destroy). It is a normal terraform@pve-style token on the TEST cluster.
PROXMOX_SDN_TEST_ENDPOINT="https://your-test-cluster.example.invalid:8006/"
PROXMOX_SDN_TEST_TOKEN="terraform@pve!ci=00000000-0000-0000-0000-000000000000"

# --- Group 2: negative-auth "missing SDN.Allocate" test (1 test) ------------
# Used by:
#   infra/tests/test_degraded_sdn_use.py
#     ::TestMissingSdnUseAuthorizationFailure::test_apply_surfaces_authorization_failure_and_provisions_nothing
#
# IMPORTANT: PROXMOX_TEST_TOKEN_NO_SDN_ALLOCATE must be a DELIBERATELY UNDER-PRIVILEGED
# token whose PVE role LACKS the SDN.Allocate privilege. The test asserts the apply
# FAILS with an authorization error and provisions nothing. A fully-privileged
# token here would make the apply unexpectedly succeed and FAIL the test.
PROXMOX_TEST_ENDPOINT="https://your-test-cluster.example.invalid:8006/"
PROXMOX_TEST_TOKEN_NO_SDN_ALLOCATE="terraform-nosdn@pve!ci=00000000-0000-0000-0000-000000000000"

# Optional: a slug that IS registered in infra/platform-foundation/projects.yaml,
# used by the negative-auth test as the project to plan against.
# Defaults to "dronefleet" (a registered slug) when unset.
PROXMOX_TEST_PROJECT_SLUG="dronefleet"

# --- SVC-07 OpenBao — Bootstrap_Transit_Token (homelab bootstrap path) ------
# Used by:
#   ansible/roles/openbao_init_unseal (task 6.2, tasks/primary_bootstrap.yml)
#
# The one-time OpenBao primary bootstrap needs the Transit unsealer's
# encrypt/decrypt-only token wired into the primary's seal "transit" stanza.
# This is the CI-OPTIONAL homelab path: export the token from this gitignored
# .env before running the init/unseal play. The pipeline path instead supplies
# the SAME variable name as a GitLab CI/CD protected+masked variable — the role
# reads it from the environment either way and does NOT hardcode CI as the only
# source.
#
# The role rotates this token into OpenBao KV
# (secret/platform/svc07/transit-token) once the primary is live, then REMOVES
# this line from the .env automatically (Req 5.5; Security AC 7). It is never
# committed in any form — this .env is gitignored and the value below is an
# obviously-fake placeholder, not a real token.
OPENBAO_BOOTSTRAP_TRANSIT_TOKEN="s.PLACEHOLDER-not-a-real-token-supply-at-bootstrap"

# Optional: GitLab API token used ONLY to delete the CI/CD protected variable
# after the token is rotated into KV (pipeline external-copy removal path).
# In-pipeline this is typically the job's own token; never committed.
GITLAB_API_TOKEN="glpat-PLACEHOLDER-not-a-real-token"

# --- SVC-07 OpenBao — engine/auth/audit CONTRACT tests (task 7.4) -----------
# Used by:
#   infra/tests/test_svc07_openbao_engine_contract.py
#     ::TestOpenBaoEngineAuthAuditContract  (4 tests: jwt/database/aws role
#      shapes + audit-line JSON contract)
#
# These requires_infra CONTRACT tests assert what a LIVE OpenBao mount shape
# actually stores/emits (Req 2.2, 2.3, 3.2, 3.3, 4.2, 4.3, 7.1). They WRITE
# disposable `ctest-*` policies/roles and a file audit device on the target
# instance, then tear them down — so OPENBAO_TEST_ADDR MUST point at an
# EPHEMERAL / THROWAWAY OpenBao, never production. When these vars are absent the
# tests SKIP cleanly. OPENBAO_TEST_TOKEN must be platform-admin/root-scoped on
# the throwaway instance; it is threaded only into request headers, never logged.
# The values below are obviously-fake placeholders — never commit a real token.
OPENBAO_TEST_ADDR="https://your-throwaway-openbao.example.invalid:8200"
OPENBAO_TEST_TOKEN="s.PLACEHOLDER-not-a-real-openbao-token"

# Optional: skip TLS verification for the ephemeral instance's self-signed cert
# (1/true = skip, the default; 0 = enforce verification).
OPENBAO_TEST_SKIP_TLS_VERIFY="1"

# Optional: a directory the live OpenBao writes /openbao/audit into AND the test
# runner can read back, needed for the Req 7.1 audit-line assertion. When unset,
# only that single assertion skips (the role-shape tests still run).
OPENBAO_TEST_AUDIT_HOST_DIR="/tmp/openbao-test-audit"

# --- SVC-07 OpenBao — dynamic PG + Garage credential INTEGRATION (task 12.2) --
# Used by:
#   infra/tests/test_svc07_openbao_dynamic_creds.py
#     ::TestOpenBaoDynamicPostgresCredentials  (2 tests: expiry-rejection +
#      bulk prefix-revoke, Req 2.1/2.2/2.4/2.6/2.8)
#     ::TestOpenBaoDynamicGarageCredentials     (1 test: mint/use/expire/reject,
#      Req 3.1/3.2/3.4)
#
# These requires_infra INTEGRATION tests exercise the full "mint -> use ->
# expire -> backend-rejects" round-trip against a LIVE OpenBao PLUS a real test
# PostgreSQL (SVC-01) and a real test Garage (SVC-03) S3 endpoint. They REUSE the
# SAME OpenBao gate as the task-7.4 contract test (OPENBAO_TEST_ADDR /
# OPENBAO_TEST_TOKEN above) — that gate is checked FIRST, so with OPENBAO_TEST_ADDR
# absent all three methods skip deterministically. The extra backend vars below
# gate only the PG- / Garage-specific sub-assertions; when a backend's vars are
# absent that backend's test skips cleanly AFTER the OpenBao gate.
#
# The tests WRITE disposable `ctest-*` database/aws connections + roles, mint
# real backend credentials, and tear everything down in a finally block — so
# point these at EPHEMERAL / THROWAWAY infrastructure only, never production. All
# admin credentials are threaded only into request bodies/headers, never logged.
# The values below are obviously-fake placeholders — never commit a real secret.

# PostgreSQL backend (Req 2). The connection_url is OpenBao's template; the
# admin user is the dedicated `openbao` superuser (Req 2.1) OpenBao mints/drops
# roles as. sslmode=disable is fine for a throwaway local test PG.
OPENBAO_TEST_PG_HOST="your-test-postgres.example.invalid"
OPENBAO_TEST_PG_PORT="5432"
OPENBAO_TEST_PG_CONN_URL="postgresql://{{username}}:{{password}}@your-test-postgres.example.invalid:5432/postgres?sslmode=disable"
OPENBAO_TEST_PG_ADMIN_USER="openbao"
OPENBAO_TEST_PG_ADMIN_PASSWORD="PLACEHOLDER-not-a-real-pg-password"
OPENBAO_TEST_PG_DB="postgres"

# Garage backend (Req 3). The aws engine is rooted on the Garage admin key pair
# against the S3-compatible endpoint; the test SigV4-signs an S3 probe (stdlib,
# no boto3) to prove accept-then-reject on expiry.
OPENBAO_TEST_GARAGE_S3_ENDPOINT="https://your-test-garage.example.invalid:3900"
OPENBAO_TEST_GARAGE_REGION="garage"
OPENBAO_TEST_GARAGE_BUCKET="ctest-bucket"
OPENBAO_TEST_GARAGE_ADMIN_ACCESS_KEY="GKPLACEHOLDER-not-a-real-access-key"
OPENBAO_TEST_GARAGE_ADMIN_SECRET_KEY="PLACEHOLDER-not-a-real-secret-key"

# Optional: shorten the disposable roles' TTL so the live tier does not wait an
# hour to observe expiry (default 10 s). The revocation BEHAVIOUR under test is
# identical regardless of TTL magnitude; the real roles ship 1h/24h (task 7.4).
OPENBAO_TEST_SHORT_TTL_SECONDS="10"
# --- Terraform → Ansible handoff — operator SSH PUBLIC key(s) (feature: terraform-ansible-handoff) ---
# Injected into both SVC-07 OpenBao LXCs' root accounts (initialization.user_account.keys)
# so Ansible can SSH in after `terraform apply`. PUBLIC key(s) ONLY — never a private key.
# Terraform reads this as TF_VAR_operator_ssh_public_keys; it is a list, so use HCL list
# syntax when exporting, e.g.:
#   export TF_VAR_operator_ssh_public_keys='["ssh-ed25519 AAAA...yourkey... operator@host"]'
# The value below is a placeholder — never commit a real key; .env is gitignored.
TF_VAR_operator_ssh_public_keys='["ssh-ed25519 AAAAPLACEHOLDER-replace-with-your-real-public-key operator@example"]'